TMDB_TOKEN=
# At least 16 characters. Leave unset to disable access (the proxy and login return 503).
RYUUJI_PASSCODE=
# Required when RYUUJI_PASSCODE is set; at least 32 characters, e.g. `openssl rand -base64 32`.
# Rotating it signs everyone out.
RYUUJI_SESSION_SECRET=
# Optional. Sessions issued before this time are rejected (ISO 8601 date-time or epoch seconds).
RYUUJI_SESSION_NOT_BEFORE=
